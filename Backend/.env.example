# ==========================================
# Pinecone Vector DB Configuration (REQUIRED for camera test & backend)
# ==========================================
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=faces-index
# PINECONE_ENVIRONMENT is optional on newer Pinecone accounts (e.g. us-east-1-aws)
PINECONE_ENVIRONMENT=us-east-1-aws

# ==========================================
# Relational Database (OPTIONAL - only needed for full FastAPI backend, NOT needed for the webcam test)
# ==========================================
DATABASE_URL=postgresql://postgres:admin@localhost:5432/attendance_db

